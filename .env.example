# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project settings → API). SÓLO server-side: la usa el cron
# del correo diario (src/lib/supabase/admin.ts). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cavala-legal-docs

# ─── Correo: invitaciones, recuperación administrativa y alertas ─────────────
# Gmail SMTP. SMTP_PASS es una contraseña de aplicación de Google, no la clave
# normal de la cuenta. Puede pegarse con o sin espacios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=
SMTP_FROM=Inversiones Cavala <tu-cuenta@gmail.com>

# Respaldo temporal de Resend: sólo se usa cuando SMTP_USER y SMTP_PASS no están
# configurados. Puede retirarse después de verificar Gmail en producción.
RESEND_API_KEY=
RESEND_FROM=Inversiones Cavala <onboarding@resend.dev>

# Secreto del cron. Al ponerlo aquí y en Vercel, Vercel Cron manda
# `Authorization: Bearer <CRON_SECRET>` automáticamente y la ruta lo exige.
CRON_SECRET=

# Correos extra que reciben el resumen, separados por coma (además de los
# administradores activos, que se toman de la tabla `perfiles`).
ALERTAS_CC=

# URL pública de la app (para los enlaces de invitación y reset de contraseña en los emails)
NEXT_PUBLIC_APP_URL=https://inversiones-cavala-eight.vercel.app

# Opcionales:
# ALERTAS_REPLY_TO=legal@inversionescavala.com
# ALERTAS_SOLO_CON_PENDIENTES=1   # no enviar el correo los días sin nada

# ─── Preview Cavala Lector IA (sólo server-side) ─────────────────────────────
# OCR recomendado a septiembre de 2026: Mistral OCR 4.1 (US$4 / 1,000 páginas).
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-1
MISTRAL_OCR_USD_PER_PAGE=0.004

# Groq atiende primero mediante su plan gratuito. Activa Zero Data Retention en
# Groq Console antes de usar documentos reales. OpenAI y xAI quedan de respaldo
# y están limitados por los cupos del usuario en `lector_ia_accesos`.
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
XAI_API_KEY=
XAI_CHAT_MODEL=grok-4.3

# Búsqueda web básica del chat. Sonar devuelve respuesta y fuentes web.
PERPLEXITY_API_KEY=
PERPLEXITY_SEARCH_MODEL=sonar
